# Optional live generative AI; without this the local trained NLP model still classifies concerns.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# REQUIRED before counsellor admin access (HTTP Basic username = counsellor)
ADMIN_PASSWORD=set-a-long-random-password
# Database path (use /tmp/niat.sqlite3 on cloud hosts without persistent disk)
NIAT_DB_PATH=/tmp/niat.sqlite3
# Demo sessions are synthetic and always visibly labeled
DEMO_MODE=1
